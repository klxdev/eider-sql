== create
table users
  id int8 not null default pk
  email text not null
  name text
  age int4 not null default
  score float8
  created_at timestamptz not null default
  tags text[] not null default
  meta jsonb
  balance numeric not null default
  unique (email)
index users_email_idx on users
unique index users_name on users

== constraints
table a
  id int4 not null pk
  b int4 not null pk
table b
  id int4 not null default pk
  a_id int4 not null
  c int4 not null
  d int4
  full_name text default
  fk (a_id) -> a()
  fk (d) -> a(id)
  unique (a_id, c)

== alter
table t2
  id int4 not null pk
  a text not null
  c int4 not null default
  e text
  fk (c) -> t(id)
  unique (a)

