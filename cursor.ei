//! sql.cursor: a position in a token list, with the small operations both parsers use (look at
//! the token, take a keyword or an operator, take an identifier, fail with the token in the message).

import sql
import sql.lex

/// The most nesting (parentheses, sub-expressions) the parsers follow; deeper input is an error, so
/// hostile text cannot overflow the stack.
pub const MAX_DEPTH: u32 = 64

pub type Cur = { toks: List[lex.Tok], i: usize, depth: u32 }

/// A cursor on `toks` (which ends with a `T_EOF` token, as `lex.lex` leaves it).
pub fn new(toks: List[lex.Tok]) -> Cur { Cur(toks, 0, 0) }

pub fn peek_at(c: Cur, k: usize) -> lex.Tok {
    let n = c.toks.len()
    if n == 0 { return lex.Tok(lex.T_EOF, String.from(""), 0, 0) }
    let j = c.i + k
    if j < n { c.toks[j] } else { c.toks[n - 1] }
}

pub fn peek(c: Cur) -> lex.Tok { peek_at(c, 0) }

pub fn at_end(c: Cur) -> bool { peek(c).kind == lex.T_EOF }

pub fn pos(c: Cur) -> usize { peek(c).pos }

/// Moves past the current token (never past the final EOF).
pub fn bump(inout c: Cur) {
    if c.i + 1 < c.toks.len() { c.i += 1 }
}

fn word_is(t: lex.Tok, kw: str) -> bool { t.kind == lex.T_WORD && t.text == String.from(kw) }
fn op_is(t: lex.Tok, op: str) -> bool { t.kind == lex.T_OP && t.text == String.from(op) }

pub fn is_word(c: Cur, kw: str) -> bool { word_is(peek(c), kw) }
pub fn is_word_at(c: Cur, k: usize, kw: str) -> bool { word_is(peek_at(c, k), kw) }
pub fn is_op(c: Cur, op: str) -> bool { op_is(peek(c), op) }
pub fn is_op_at(c: Cur, k: usize, op: str) -> bool { op_is(peek_at(c, k), op) }

pub fn eat_word(inout c: Cur, kw: str) -> bool {
    if is_word(c, kw) {
        bump(inout c)
        return true
    }
    false
}

pub fn eat_op(inout c: Cur, op: str) -> bool {
    if is_op(c, op) {
        bump(inout c)
        return true
    }
    false
}

/// An error at the current token: `<msg>, found <token>`.
pub fn fail(c: Cur, msg: String) -> sql.Error {
    let t = peek(c)
    let mut m = msg.copy()
    m.push_str(", found ")
    m.append(lex.describe(t))
    sql.error(m, t.pos)
}

pub fn expect_word(inout c: Cur, kw: str) -> Result[(), sql.Error] {
    if eat_word(inout c, kw) { return Ok(()) }
    let mut m = String.from("expected `")
    m.push_str(kw)
    m.push_str("`")
    Err(fail(c, m))
}

pub fn expect_op(inout c: Cur, op: str) -> Result[(), sql.Error] {
    if eat_op(inout c, op) { return Ok(()) }
    let mut m = String.from("expected `")
    m.push_str(op)
    m.push_str("`")
    Err(fail(c, m))
}

/// Words that cannot be a name without quotes (PostgreSQL's reserved keywords, the ones that
/// matter for telling a name from the clause that follows it).
pub fn reserved(w: String) -> bool {
    let words = List["all", "analyse", "analyze", "and", "any", "array", "as", "asc", "asymmetric", "both", "case", "cast", "check", "collate", "column", "constraint", "create", "current_catalog", "current_date", "current_role", "current_time", "current_timestamp", "current_user", "default", "deferrable", "desc", "distinct", "do", "else", "end", "except", "false", "fetch", "for", "foreign", "from", "grant", "group", "having", "in", "initially", "intersect", "into", "lateral", "leading", "limit", "localtime", "localtimestamp", "not", "null", "offset", "on", "only", "or", "order", "placing", "primary", "references", "returning", "select", "session_user", "some", "symmetric", "table", "then", "to", "trailing", "true", "union", "unique", "user", "using", "variadic", "when", "where", "window", "with"]
    for x in words {
        if w == String.from(x) { return true }
    }
    false
}

/// Words that may follow a table or column and must not be taken as its alias.
pub fn alias_stop(w: String) -> bool {
    if reserved(w.copy()) { return true }
    let words = List["join", "inner", "left", "right", "full", "cross", "natural", "outer", "set", "values", "returning", "window", "over", "filter", "within", "tablesample"]
    for x in words {
        if w == String.from(x) { return true }
    }
    false
}

/// A name: an unquoted word that is not reserved, or a quoted identifier.
pub fn name(inout c: Cur) -> Result[String, sql.Error] {
    let t = peek(c)
    if t.kind == lex.T_QUOTED {
        bump(inout c)
        return Ok(t.text)
    }
    if t.kind == lex.T_WORD && !reserved(t.text.copy()) {
        bump(inout c)
        return Ok(t.text)
    }
    Err(fail(c, String.from("expected a name")))
}

/// A name that may be a reserved word (after a dot, or as a column alias after `AS`).
pub fn any_name(inout c: Cur) -> Result[String, sql.Error] {
    let t = peek(c)
    if t.kind == lex.T_QUOTED || t.kind == lex.T_WORD {
        bump(inout c)
        return Ok(t.text)
    }
    Err(fail(c, String.from("expected a name")))
}

/// A possibly qualified name: `name`, `schema.name`. The `public` and `pg_catalog` schemas are dropped;
/// another schema is kept (`app.users`). More than two parts is an error.
pub fn qname(inout c: Cur) -> Result[String, sql.Error] {
    let first = name(inout c)?
    if !is_op(c, ".") { return Ok(first) }
    bump(inout c)
    let second = any_name(inout c)?
    if is_op(c, ".") { return Err(sql.unsupported(String.from("a name with three parts"), pos(c))) }
    if first == String.from("public") || first == String.from("pg_catalog") { return Ok(second) }
    let mut s = first.copy()
    s.push_str(".")
    s.append(second)
    Ok(s)
}

/// Skips a parenthesized group: expects `(`, goes past the matching `)`.
pub fn skip_parens(inout c: Cur) -> Result[(), sql.Error] {
    expect_op(inout c, "(")?
    let mut depth: i32 = 1
    while !at_end(c) {
        let t = peek(c)
        if t.kind == lex.T_OP {
            if t.text == String.from("(") {
                depth += 1
            } else if t.text == String.from(")") {
                depth -= 1
                if depth == 0 {
                    bump(inout c)
                    return Ok(())
                }
            }
        }
        if depth > 1000 { return Err(sql.error(String.from("the statement is nested too deeply"), t.pos)) }
        bump(inout c)
    }
    Err(sql.error(String.from("unbalanced parentheses"), pos(c)))
}

/// `( name, name, ... )`.
pub fn name_list(inout c: Cur) -> Result[List[String], sql.Error] {
    expect_op(inout c, "(")?
    let mut out: List[String] = List.new()
    out.push(any_name(inout c)?)
    while eat_op(inout c, ",") { out.push(any_name(inout c)?) }
    expect_op(inout c, ")")?
    Ok(out)
}

pub fn enter(inout c: Cur) -> Result[(), sql.Error] {
    c.depth += 1
    if c.depth > MAX_DEPTH {
        return Err(sql.error(String.from("the statement is nested too deeply"), pos(c)))
    }
    Ok(())
}

pub fn leave(inout c: Cur) {
    if c.depth > 0 { c.depth -= 1 }
}

/// Skips tokens up to, not including, the `,` or `)` that ends the current item at nesting depth 0
/// (or the end of the statement); parentheses and brackets inside are skipped balanced.
pub fn skip_item(inout c: Cur, stop_words: List[str]) -> Result[(), sql.Error] {
    let mut depth: i32 = 0
    while !at_end(c) {
        let t = peek(c)
        if t.kind == lex.T_OP {
            if t.text == String.from("(") || t.text == String.from("[") {
                depth += 1
            } else if t.text == String.from(")") || t.text == String.from("]") {
                if depth == 0 { return Ok(()) }
                depth -= 1
            } else if depth == 0 && (t.text == String.from(",") || t.text == String.from(";")) {
                return Ok(())
            }
        } else if depth == 0 && t.kind == lex.T_WORD {
            for w in stop_words {
                if t.text == String.from(w) { return Ok(()) }
            }
        }
        if depth > 1000 { return Err(sql.error(String.from("the statement is nested too deeply"), t.pos)) }
        bump(inout c)
    }
    Ok(())
}
